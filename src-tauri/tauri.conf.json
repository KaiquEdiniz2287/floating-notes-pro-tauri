{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Floating Notes Pro",
  "version": "2.0.0",
  "identifier": "com.kaio.floatingnotes",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node copy-frontend.js",
    "beforeBuildCommand": "node copy-frontend.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Floating Notes Pro",
        "width": 1100,
        "height": 750,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
